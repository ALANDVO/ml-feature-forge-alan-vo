APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEMO_MODE=true
DATABASE_PATH=feature_forge.db

# LLM Provider Configuration (Server-side only)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Keycloak OIDC & SAML Broker Configuration
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/feature-forge
OIDC_CLIENT_ID=feature-forge-client
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=feature-forge-client
JWT_SIGNING_KEY=
